{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Iniciar Festival SONORA",
      "type": "shell",
      "command": "python3 iniciar.py",
      "windows": {
        "command": "if (Get-Command py -ErrorAction SilentlyContinue) { py -3 iniciar.py } else { python iniciar.py }",
        "options": {
          "shell": {
            "executable": "powershell.exe",
            "args": [
              "-NoProfile",
              "-Command"
            ]
          }
        }
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}